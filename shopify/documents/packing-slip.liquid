{% comment %}
  Packing slip — Swift TCG branded
  Paste into: Apps → Order Printer → Templates → Packing slip
  Paper: US Letter. HTML / CSS / Liquid only.
{% endcomment %}

<style>
  @page { size: letter; margin: 0.5in; }
  * { box-sizing: border-box; }
  .doc {
    font-family: Helvetica, Arial, sans-serif;
    color: #111111;
    font-size: 10pt;
    line-height: 1.45;
    background: #ffffff;
  }
  .doc img { max-width: 100%; }
  .brand-logo { display: block; width: 160px; height: auto; }
  .header { width: 100%; border-collapse: collapse; }
  .header td { vertical-align: top; padding: 0; }
  .doc-kicker {
    margin: 0 0 4px;
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #0EA54B;
  }
  .doc-title {
    margin: 0;
    font-size: 18pt;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .meta { margin: 6px 0 0; color: #333333; font-size: 10pt; text-align: right; }
  .rule {
    height: 3px;
    background: #0EA54B;
    border: 0;
    margin: 14px 0 18px;
  }
  .cols { width: 100%; border-collapse: collapse; margin: 0 0 18px; }
  .cols td { width: 50%; vertical-align: top; padding: 0 24px 0 0; }
  .cols td:last-child { padding: 0; }
  .label {
    margin: 0 0 6px;
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #111111;
  }
  .block { margin: 0; color: #111111; }
  .items { width: 100%; border-collapse: collapse; margin: 8px 0 0; }
  .items th {
    text-align: left;
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-bottom: 1px solid #111111;
    padding: 0 8px 8px 0;
  }
  .items th.qty,
  .items td.qty { text-align: right; padding-right: 0; }
  .items td {
    border-bottom: 1px solid #e5e5e5;
    padding: 10px 8px 10px 0;
    vertical-align: middle;
  }
  .thumb {
    width: 48px;
    height: 48px;
    object-fit: contain;
    border: 1px solid #e5e5e5;
    background: #ffffff;
  }
  .item-title { font-weight: 700; }
  .sku { color: #333333; font-size: 9pt; }
  .props { margin: 4px 0 0; color: #333333; font-size: 9pt; }
  .notice {
    margin: 22px 0 0;
    padding: 10px 12px;
    border: 1px solid #dddddd;
  }
  .notice strong { display: block; margin: 0 0 4px; font-size: 9pt; letter-spacing: 0.08em; text-transform: uppercase; }
  .notice p { margin: 0; font-size: 9pt; color: #333333; }
  .thanks { margin: 22px 0 0; }
  .thanks p { margin: 0 0 6px; }
  .support { margin: 0; color: #333333; font-size: 9pt; }
  .support a { color: #111111; text-decoration: none; }
  @media print {
    .doc { background: #ffffff; }
    .rule { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
    .items tr { page-break-inside: avoid; }
  }
</style>

<div class="doc">
  <table class="header">
    <tr>
      <td>
        <img
          class="brand-logo"
          src="https://www.swifttcg.com/brand/swift-tcg-logo.png"
          alt="{{ shop.name }}"
          width="160"
        />
      </td>
      <td style="text-align: right;">
        <p class="doc-kicker">Packing slip</p>
        <h1 class="doc-title">{{ order.order_name }}</h1>
        <p class="meta">
          {{ order.created_at | date: "%B %e, %Y" }}<br />
          {% if order.po_number != blank %}PO # {{ order.po_number }}<br />{% endif %}
          {% if order.shipping_methods.size > 0 %}
            {% for shipping_method in order.shipping_methods %}
              {{ shipping_method.title }}{% unless forloop.last %}, {% endunless %}
            {% endfor %}
          {% elsif order.shipping_method %}
            {{ order.shipping_method.title }}
          {% endif %}
        </p>
      </td>
    </tr>
  </table>

  <hr class="rule" />

  <table class="cols">
    <tr>
      <td>
        <p class="label">Ship to</p>
        {% if order.shipping_address %}
          <p class="block">
            <strong>{{ order.shipping_address.name }}</strong><br />
            {{ order.shipping_address | format_address }}
            {% if order.shipping_address.phone != blank %}
              <br />{{ order.shipping_address.phone }}
            {% endif %}
          </p>
        {% elsif order.customer %}
          <p class="block"><strong>{{ order.customer.name }}</strong></p>
        {% endif %}
      </td>
      <td>
        <p class="label">From</p>
        <p class="block">
          <strong>{{ shop.name }}</strong><br />
          {{ shop.address | format_address }}
          {% if shop.phone != blank %}<br />{{ shop.phone }}{% endif %}
          {% if shop.email != blank %}<br />{{ shop.email }}{% endif %}
        </p>
      </td>
    </tr>
  </table>

  {% if order.note != blank or order.customer.note != blank %}
    <p class="label">Notes</p>
    {% if order.note != blank %}<p class="block">{{ order.note }}</p>{% endif %}
    {% if order.customer.note != blank %}<p class="block">{{ order.customer.note }}</p>{% endif %}
  {% endif %}

  <table class="items">
    <thead>
      <tr>
        <th style="width: 56px;">Item</th>
        <th>Product</th>
        <th style="width: 28%;">SKU</th>
        <th class="qty" style="width: 10%;">Qty</th>
      </tr>
    </thead>
    <tbody>
      {% for line_item in order.line_items %}
        <tr>
          <td>
            {% if line_item.image != blank %}
              {{ line_item.image | img_url: '96x96' | img_tag: line_item.title, 'thumb' }}
            {% elsif line_item.product.featured_image %}
              {{ line_item.product.featured_image | product_img_url: 'small' | img_tag: line_item.title, 'thumb' }}
            {% endif %}
          </td>
          <td>
            <span class="item-title">{{ line_item.title }}</span>
            {% if line_item.variant_title != blank and line_item.variant_title != 'Default Title' %}
              <br /><span class="sku">{{ line_item.variant_title }}</span>
            {% endif %}
            {% if line_item.vendor != blank %}
              <br /><span class="sku">{{ line_item.vendor }}</span>
            {% endif %}
            {% if line_item.groups %}
              {% for group in line_item.groups %}
                <br /><span class="sku">{{ group.title }}</span>
              {% endfor %}
            {% endif %}
            {% for property in line_item.properties %}
              {% assign property_first_char = property.first | slice: 0 %}
              {% if property.last != blank and property_first_char != '_' %}
                <div class="props">{{ property.first }}: {{ property.last }}</div>
              {% endif %}
            {% endfor %}
          </td>
          <td class="sku">{{ line_item.sku }}</td>
          <td class="qty"><strong>{{ line_item.quantity }}</strong></td>
        </tr>
      {% endfor %}
    </tbody>
  </table>

  <div class="notice">
    <strong>Final sale</strong>
    <p>Due to the collectible nature of trading card products, all sales are final except for damaged or incorrect items.</p>
  </div>

  <div class="thanks">
    <p><strong>Thank you for your order.</strong></p>
    <p class="support">
      Questions? Email <a href="mailto:support@swifttcg.com">support@swifttcg.com</a><br />
      <a href="https://www.swifttcg.com">https://www.swifttcg.com</a>
      {% if shop.domain != blank %}<br />{{ shop.domain }}{% endif %}
    </p>
    <p class="support">Authentic Japanese TCG imports — factory sealed, shipped from California.</p>
  </div>
</div>
