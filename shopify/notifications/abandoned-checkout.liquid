<!--
  Abandoned checkout — Swift TCG branded (mobile-friendly)
  “Your cart is waiting” / “Your item is waiting”
  Sent when a customer leaves checkout before completing purchase.

  Paste into: Settings → Notifications → Abandoned checkout → Edit code
  (or Messaging → Recover abandoned checkout → Custom Liquid)

  Required Liquid (do not remove):
  - {{ url }} — checkout recovery link
  - {{ subtotal_line_items }} — cart line items
  - {{ item_count }}, {{ billing_address }}, {{ custom_message }}
  - shop / money / img_url filters used below

  Unsubscribe is provided by Shopify Messaging footer when used there —
  do not duplicate it in this body.
-->
{% capture email_title %}
  {% if item_count == 1 %}
    Your item is waiting
  {% else %}
    Your cart is waiting
  {% endif %}
{% endcapture %}
{% capture email_body %}
  {% if billing_address.first_name %}
    {% if item_count == 1 %}
      Hi {{ billing_address.first_name }}, you left an item in your cart. Complete your order now while it’s still available.
    {% else %}
      Hi {{ billing_address.first_name }}, you left items in your cart. Complete your order now while they’re still available.
    {% endif %}
  {% else %}
    {% if item_count == 1 %}
      Hi, you left an item in your cart. Complete your order now while it’s still available.
    {% else %}
      Hi, you left items in your cart. Complete your order now while they’re still available.
    {% endif %}
  {% endif %}
{% endcapture %}

<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
  <head>
    <title>{{ email_title }}</title>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="x-apple-disable-message-reformatting">
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no">
    <!--[if mso]>
    <noscript>
      <xml>
        <o:OfficeDocumentSettings>
          <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
      </xml>
    </noscript>
    <![endif]-->
    <style>
      html, body {
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
      }
      body, table, td, div, p, a, span, h1, h2, h3 {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif !important;
      }
      table, td {
        border-collapse: collapse;
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
      }
      img {
        border: 0;
        outline: none;
        text-decoration: none;
        -ms-interpolation-mode: bicubic;
        display: block;
      }
      a { color: #0EA54B; text-decoration: none; }
      a[x-apple-data-detectors] {
        color: inherit !important;
        text-decoration: none !important;
        font-size: inherit !important;
        font-family: inherit !important;
        font-weight: inherit !important;
        line-height: inherit !important;
      }

      @media only screen and (max-width: 620px) {
        .email-shell {
          width: 100% !important;
          max-width: 100% !important;
        }
        .content-pad {
          padding-left: 20px !important;
          padding-right: 20px !important;
        }
        .header-pad {
          padding: 24px 20px 18px !important;
        }
        .hero-pad {
          padding: 28px 20px 8px !important;
        }
        .items-pad {
          padding: 20px 20px 8px !important;
        }
        .footer-pad {
          padding: 24px 20px 28px !important;
        }
        .hero-title {
          font-size: 24px !important;
          line-height: 1.25 !important;
        }
        .hero-body {
          font-size: 15px !important;
        }
        .btn-cell {
          width: 100% !important;
        }
        .btn-link {
          display: block !important;
          width: 100% !important;
          box-sizing: border-box !important;
          padding: 16px 20px !important;
          text-align: center !important;
        }
        .product-thumb {
          width: 72px !important;
          height: 72px !important;
        }
        .product-thumb-cell {
          width: 72px !important;
        }
        .product-copy {
          padding-left: 12px !important;
        }
        .product-price {
          display: block !important;
          padding: 6px 0 0 0 !important;
          text-align: left !important;
          white-space: normal !important;
        }
        .product-price-cell {
          display: block !important;
          width: 100% !important;
          padding-left: 84px !important;
          padding-top: 4px !important;
          text-align: left !important;
        }
        .logo-img {
          width: 140px !important;
          max-width: 140px !important;
          height: auto !important;
        }
      }
    </style>
  </head>
  <body style="margin:0;padding:0;background-color:#ffffff;width:100%;">

    <div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;">
      Your checkout is still open — complete your order while stock lasts.
      &nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff;margin:0;padding:0;width:100%;">
      <tr>
        <td align="center" style="padding:0;">

          <table role="presentation" class="email-shell" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;background-color:#ffffff;">

            <!-- Header / logo -->
            <tr>
              <td class="header-pad content-pad" align="left" style="padding:32px 40px 24px;border-bottom:3px solid #0EA54B;">
                {%- if shop.email_logo_url %}
                  <a href="{{ shop.url }}" target="_blank" style="display:inline-block;text-decoration:none;line-height:1;">
                    <img
                      class="logo-img"
                      src="{{ shop.email_logo_url }}"
                      alt="{{ shop.name }}"
                      width="{{ shop.email_logo_width }}"
                      style="display:block;border:0;outline:none;text-decoration:none;max-width:160px;height:auto;"
                    >
                  </a>
                {%- else %}
                  <a href="{{ shop.url }}" target="_blank" style="display:inline-block;text-decoration:none;line-height:1;">
                    <img
                      class="logo-img"
                      src="https://swifttcg.com/brand/swift-tcg-logo-email.png"
                      alt="Swift TCG"
                      width="160"
                      height="49"
                      style="display:block;border:0;outline:none;text-decoration:none;width:160px;max-width:100%;height:auto;"
                    >
                  </a>
                {%- endif %}
              </td>
            </tr>

            <!-- Hero -->
            <tr>
              <td class="hero-pad content-pad" align="left" style="padding:36px 40px 12px;">
                <h1 class="hero-title" style="margin:0 0 14px;color:#111111;font-size:28px;font-weight:700;letter-spacing:-0.02em;line-height:1.25;">
                  {{ email_title }}
                </h1>

                {% if custom_message != blank %}
                  <p class="hero-body" style="margin:0 0 8px;color:#444444;font-size:16px;line-height:1.6;">
                    {{ custom_message }}
                  </p>
                {% else %}
                  <p class="hero-body" style="margin:0 0 8px;color:#444444;font-size:16px;line-height:1.6;">
                    {{ email_body }}
                  </p>
                {% endif %}

                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:24px 0 8px;border-collapse:separate !important;">
                  <tr>
                    <td class="btn-cell" align="left" style="background-color:#0EA54B;border-radius:8px;text-align:center;">
                      <!--[if mso]>
                      <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{ url }}" style="height:48px;v-text-anchor:middle;width:240px;" arcsize="17%" stroke="f" fillcolor="#0EA54B">
                        <w:anchorlock/>
                        <center style="color:#ffffff;font-family:Helvetica,Arial,sans-serif;font-size:15px;font-weight:700;">Complete Your Order</center>
                      </v:roundrect>
                      <![endif]-->
                      <!--[if !mso]><!-- -->
                      <a class="btn-link" href="{{ url }}" target="_blank" style="display:inline-block;padding:16px 28px;color:#ffffff !important;font-size:15px;font-weight:700;letter-spacing:0.01em;text-decoration:none;line-height:1.2;border-radius:8px;background-color:#0EA54B;">
                        Complete Your Order
                      </a>
                      <!--<![endif]-->
                    </td>
                  </tr>
                </table>

                {% if shop.url %}
                  <p style="margin:12px 0 0;color:#666666;font-size:14px;line-height:1.5;">
                    or <a href="{{ shop.url }}" target="_blank" style="color:#0EA54B;font-weight:600;text-decoration:none;">visit the store</a>
                  </p>
                {% endif %}
              </td>
            </tr>

            <!-- Cart items -->
            <tr>
              <td class="items-pad content-pad" align="left" style="padding:24px 40px 8px;">
                <h2 style="margin:0 0 16px;color:#111111;font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;line-height:1.3;">
                  Items in your cart
                </h2>

                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
                  {% for line in subtotal_line_items %}
                    <tr>
                      <td style="padding:14px 0;border-bottom:1px solid #eeeeee;">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
                          <tr>
                            <td class="product-thumb-cell" width="64" valign="top" style="width:64px;vertical-align:top;">
                              {% if line.image %}
                                <a href="{{ url }}" target="_blank" style="text-decoration:none;">
                                  <img
                                    class="product-thumb"
                                    src="{{ line | img_url: 'compact_cropped' }}"
                                    alt=""
                                    width="64"
                                    height="64"
                                    style="display:block;width:64px;height:64px;border:1px solid #eeeeee;border-radius:6px;object-fit:cover;"
                                  >
                                </a>
                              {% else %}
                                <div style="width:64px;height:64px;border:1px solid #eeeeee;border-radius:6px;background:#f7f7f7;"></div>
                              {% endif %}
                            </td>
                            <td class="product-copy" valign="top" style="padding-left:14px;vertical-align:top;">
                              {% if line.product.title %}
                                {% assign line_title = line.product.title %}
                              {% else %}
                                {% assign line_title = line.title %}
                              {% endif %}

                              {% assign line_display = line.quantity %}

                              <a href="{{ url }}" target="_blank" style="text-decoration:none;">
                                <span style="display:block;margin:0 0 4px;color:#111111;font-size:15px;font-weight:600;line-height:1.35;">
                                  {{ line_title }}&nbsp;&times;&nbsp;{{ line_display }}
                                </span>
                              </a>

                              {% if line.variant.title != 'Default Title' %}
                                <span style="display:block;color:#666666;font-size:13px;line-height:1.4;">
                                  {{ line.variant.title }}
                                </span>
                              {% endif %}

                              {% for p in line.properties %}
                                {% unless p.last == blank %}
                                  <span style="display:block;color:#666666;font-size:13px;line-height:1.4;">
                                    {{ p.first }}: {{ p.last }}
                                  </span>
                                {% endunless %}
                              {% endfor %}

                              {% if line.selling_plan_allocation %}
                                <span style="display:block;color:#666666;font-size:13px;line-height:1.4;">
                                  {{ line.selling_plan_allocation.selling_plan.name }}
                                </span>
                              {% endif %}

                              {% if line.refunded_quantity > 0 %}
                                <span style="display:block;color:#666666;font-size:13px;line-height:1.4;">
                                  Refunded
                                </span>
                              {% endif %}

                              {% if line.discount_allocations %}
                                {% for discount_allocation in line.discount_allocations %}
                                  {% if discount_allocation.discount_application.target_selection != 'all' %}
                                    <span style="display:inline-block;margin-top:4px;color:#0EA54B;font-size:12px;line-height:1.4;">
                                      {{ discount_allocation.discount_application.title | upcase }}
                                      (-{{ discount_allocation.amount | money }})
                                    </span>
                                  {% endif %}
                                {% endfor %}
                              {% endif %}
                            </td>
                            <td class="product-price-cell" valign="top" align="right" style="padding-left:16px;vertical-align:top;text-align:right;white-space:nowrap;">
                              {% if line.original_line_price != line.final_line_price %}
                                <del class="product-price" style="display:block;color:#999999;font-size:13px;text-align:right;">
                                  {{ line.original_line_price | money }}
                                </del>
                              {% endif %}
                              <p class="product-price" style="margin:0;color:#111111;font-size:15px;font-weight:600;white-space:nowrap;text-align:right;">
                                {% if line.final_line_price > 0 %}
                                  {{ line.final_line_price | money }}
                                {% else %}
                                  Free
                                {% endif %}
                              </p>
                            </td>
                          </tr>
                        </table>
                      </td>
                    </tr>
                  {% endfor %}
                </table>

                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:28px 0 8px;border-collapse:separate !important;">
                  <tr>
                    <td class="btn-cell" align="left" style="background-color:#0EA54B;border-radius:8px;text-align:center;">
                      <!--[if mso]>
                      <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{ url }}" style="height:48px;v-text-anchor:middle;width:240px;" arcsize="17%" stroke="f" fillcolor="#0EA54B">
                        <w:anchorlock/>
                        <center style="color:#ffffff;font-family:Helvetica,Arial,sans-serif;font-size:15px;font-weight:700;">Complete Your Order</center>
                      </v:roundrect>
                      <![endif]-->
                      <!--[if !mso]><!-- -->
                      <a class="btn-link" href="{{ url }}" target="_blank" style="display:inline-block;padding:16px 28px;color:#ffffff !important;font-size:15px;font-weight:700;letter-spacing:0.01em;text-decoration:none;line-height:1.2;border-radius:8px;background-color:#0EA54B;">
                        Complete Your Order
                      </a>
                      <!--<![endif]-->
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td class="footer-pad content-pad" align="left" style="padding:32px 40px 28px;border-top:1px solid #e8e8e8;">
                <p style="margin:0 0 8px;color:#666666;font-size:13px;line-height:1.55;">
                  Questions? Email us at <a href="mailto:support@swifttcg.com" style="color:#0EA54B;text-decoration:none;">support@swifttcg.com</a>
                </p>
                <p style="margin:0;color:#666666;font-size:13px;line-height:1.55;">
                  <a href="https://swifttcg.com" target="_blank" style="color:#0EA54B;text-decoration:none;">swifttcg.com</a>
                </p>
              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>
  </body>
</html>
