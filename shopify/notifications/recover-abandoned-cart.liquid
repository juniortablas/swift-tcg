<!--
  Recover abandoned cart — Swift TCG branded (mobile-friendly)
  Shopify Messaging: customers who add items to cart but never start checkout.
  Subject suggestion: We saved your cart for you

  Paste into: Shopify admin → Marketing / Messaging → Automations → Recover abandoned cart
  → Edit email → Code your own (or Custom Liquid), then replace the HTML body.

  Required Liquid (do not remove):
  - {{ abandoned_visit.url }} — cart recovery link
  - {{ abandoned_visit.products_added_to_cart }} — product list
  - {{ open_tracking_block }} — required when open tracking is enabled

  Unsubscribe is provided by the Shopify Messaging email footer — do not duplicate it here.
-->
<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="x-apple-disable-message-reformatting">
    <meta name="format-detection" content="telephone=no, date=no, address=no, email=no">
    <title>We saved your cart for you</title>
    <!--[if mso]>
    <noscript>
      <xml>
        <o:OfficeDocumentSettings>
          <o:PixelsPerInch>96</o:PixelsPerInch>
        </o:OfficeDocumentSettings>
      </xml>
    </noscript>
    <![endif]-->
    <style>
      /* Client resets */
      html, body {
        margin: 0 !important;
        padding: 0 !important;
        width: 100% !important;
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
      }
      body, table, td, div, p, a, span, h1, h2, h3 {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif !important;
      }
      table, td {
        border-collapse: collapse;
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
      }
      img {
        border: 0;
        outline: none;
        text-decoration: none;
        -ms-interpolation-mode: bicubic;
        display: block;
      }
      a { color: #0EA54B; text-decoration: none; }
      a[x-apple-data-detectors] {
        color: inherit !important;
        text-decoration: none !important;
        font-size: inherit !important;
        font-family: inherit !important;
        font-weight: inherit !important;
        line-height: inherit !important;
      }

      /* Mobile */
      @media only screen and (max-width: 620px) {
        .email-shell {
          width: 100% !important;
          max-width: 100% !important;
        }
        .content-pad {
          padding-left: 20px !important;
          padding-right: 20px !important;
        }
        .header-pad {
          padding: 24px 20px 18px !important;
        }
        .hero-pad {
          padding: 28px 20px 8px !important;
        }
        .items-pad {
          padding: 20px 20px 8px !important;
        }
        .footer-pad {
          padding: 24px 20px 28px !important;
        }
        .hero-title {
          font-size: 24px !important;
          line-height: 1.25 !important;
        }
        .hero-body {
          font-size: 15px !important;
        }
        .btn-cell {
          width: 100% !important;
        }
        .btn-link {
          display: block !important;
          width: 100% !important;
          box-sizing: border-box !important;
          padding: 16px 20px !important;
          text-align: center !important;
        }
        .product-thumb {
          width: 72px !important;
          height: 72px !important;
        }
        .product-thumb-cell {
          width: 72px !important;
        }
        .product-copy {
          padding-left: 12px !important;
        }
        .logo-img {
          width: 140px !important;
          max-width: 140px !important;
          height: auto !important;
        }
      }
    </style>
  </head>
  <body style="margin:0;padding:0;background-color:#ffffff;width:100%;">
    {{ open_tracking_block }}

    <!-- Preheader (hidden inbox preview) -->
    <div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;">
      Your cart is saved — jump back in and complete your order while stock lasts.
      &nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;&zwnj;&nbsp;
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#ffffff;margin:0;padding:0;width:100%;">
      <tr>
        <td align="center" style="padding:0;">

          <table role="presentation" class="email-shell" width="600" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;background-color:#ffffff;">

            <!-- Header / logo -->
            <tr>
              <td class="header-pad content-pad" align="left" style="padding:32px 40px 24px;border-bottom:3px solid #0EA54B;">
                <a href="{{ shop.url }}" target="_blank" style="display:inline-block;text-decoration:none;line-height:1;">
                  <img
                    class="logo-img"
                    src="https://swifttcg.com/brand/swift-tcg-logo-email.png"
                    alt="Swift TCG"
                    width="160"
                    height="49"
                    style="display:block;border:0;outline:none;text-decoration:none;width:160px;max-width:100%;height:auto;"
                  >
                </a>
              </td>
            </tr>

            <!-- Hero -->
            <tr>
              <td class="hero-pad content-pad" align="left" style="padding:36px 40px 12px;">
                <h1 class="hero-title" style="margin:0 0 14px;color:#111111;font-size:28px;font-weight:700;letter-spacing:-0.02em;line-height:1.25;">
                  We saved your cart for you
                </h1>

                <p class="hero-body" style="margin:0 0 8px;color:#444444;font-size:16px;line-height:1.6;">
                  {% if customer.first_name != blank %}
                    Hi {{ customer.first_name }}, your items are still here. Complete your order while they’re available.
                  {% else %}
                    Hi, your items are still here. Complete your order while they’re available.
                  {% endif %}
                </p>

                <!-- Primary CTA -->
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:24px 0 8px;border-collapse:separate !important;">
                  <tr>
                    <td class="btn-cell" align="left" style="background-color:#0EA54B;border-radius:8px;text-align:center;">
                      <!--[if mso]>
                      <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{ abandoned_visit.url }}" style="height:48px;v-text-anchor:middle;width:240px;" arcsize="17%" stroke="f" fillcolor="#0EA54B">
                        <w:anchorlock/>
                        <center style="color:#ffffff;font-family:Helvetica,Arial,sans-serif;font-size:15px;font-weight:700;">Return to Cart</center>
                      </v:roundrect>
                      <![endif]-->
                      <!--[if !mso]><!-- -->
                      <a class="btn-link" href="{{ abandoned_visit.url }}" target="_blank" style="display:inline-block;padding:16px 28px;color:#ffffff !important;font-size:15px;font-weight:700;letter-spacing:0.01em;text-decoration:none;line-height:1.2;border-radius:8px;background-color:#0EA54B;">
                        Return to Cart
                      </a>
                      <!--<![endif]-->
                    </td>
                  </tr>
                </table>

                {% if shop.url %}
                  <p style="margin:12px 0 0;color:#666666;font-size:14px;line-height:1.5;">
                    or <a href="{{ shop.url }}" target="_blank" style="color:#0EA54B;font-weight:600;text-decoration:none;">visit the store</a>
                  </p>
                {% endif %}
              </td>
            </tr>

            <!-- Cart items -->
            <tr>
              <td class="items-pad content-pad" align="left" style="padding:24px 40px 8px;">
                <h2 style="margin:0 0 16px;color:#111111;font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;line-height:1.3;">
                  Items in your cart
                </h2>

                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
                  {% for product in abandoned_visit.products_added_to_cart %}
                    <tr>
                      <td style="padding:14px 0;border-bottom:1px solid #eeeeee;">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;">
                          <tr>
                            <td class="product-thumb-cell" width="64" valign="middle" style="width:64px;vertical-align:middle;">
                              {% if product.image_url != blank %}
                                <a href="{{ abandoned_visit.url }}" target="_blank" style="text-decoration:none;">
                                  <img
                                    class="product-thumb"
                                    src="{{ product.image_url }}"
                                    alt="{{ product.title }}"
                                    width="64"
                                    height="64"
                                    style="display:block;width:64px;height:64px;border:1px solid #eeeeee;border-radius:6px;object-fit:cover;"
                                  >
                                </a>
                              {% else %}
                                <div style="width:64px;height:64px;border:1px solid #eeeeee;border-radius:6px;background:#f7f7f7;"></div>
                              {% endif %}
                            </td>
                            <td class="product-copy" valign="middle" style="padding-left:14px;vertical-align:middle;">
                              <a href="{{ abandoned_visit.url }}" target="_blank" style="text-decoration:none;">
                                <span style="display:block;margin:0 0 4px;color:#111111;font-size:15px;font-weight:600;line-height:1.35;">
                                  {{ product.title }}{% if product.quantity %}&nbsp;&times;&nbsp;{{ product.quantity }}{% endif %}
                                </span>
                              </a>
                              {% if product.variant_title != blank and product.variant_title != 'Default Title' %}
                                <span style="display:block;color:#666666;font-size:13px;line-height:1.4;">
                                  {{ product.variant_title }}
                                </span>
                              {% endif %}
                            </td>
                          </tr>
                        </table>
                      </td>
                    </tr>
                  {% endfor %}
                </table>

                {% if abandoned_visit.remaining_cart_products_count and abandoned_visit.remaining_cart_products_count > 0 %}
                  <p style="margin:14px 0 0;color:#666666;font-size:13px;line-height:1.5;">
                    + {{ abandoned_visit.remaining_cart_products_count }} more in your cart
                  </p>
                {% endif %}

                <!-- Secondary CTA -->
                <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:28px 0 8px;border-collapse:separate !important;">
                  <tr>
                    <td class="btn-cell" align="left" style="background-color:#0EA54B;border-radius:8px;text-align:center;">
                      <!--[if mso]>
                      <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{ abandoned_visit.url }}" style="height:48px;v-text-anchor:middle;width:240px;" arcsize="17%" stroke="f" fillcolor="#0EA54B">
                        <w:anchorlock/>
                        <center style="color:#ffffff;font-family:Helvetica,Arial,sans-serif;font-size:15px;font-weight:700;">Return to Cart</center>
                      </v:roundrect>
                      <![endif]-->
                      <!--[if !mso]><!-- -->
                      <a class="btn-link" href="{{ abandoned_visit.url }}" target="_blank" style="display:inline-block;padding:16px 28px;color:#ffffff !important;font-size:15px;font-weight:700;letter-spacing:0.01em;text-decoration:none;line-height:1.2;border-radius:8px;background-color:#0EA54B;">
                        Return to Cart
                      </a>
                      <!--<![endif]-->
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td class="footer-pad content-pad" align="left" style="padding:32px 40px 28px;border-top:1px solid #e8e8e8;">
                <p style="margin:0 0 8px;color:#666666;font-size:13px;line-height:1.55;">
                  Questions? Email us at <a href="mailto:support@swifttcg.com" style="color:#0EA54B;text-decoration:none;">support@swifttcg.com</a>
                </p>
                <p style="margin:0 0 8px;color:#666666;font-size:13px;line-height:1.55;">
                  <a href="https://swifttcg.com" target="_blank" style="color:#0EA54B;text-decoration:none;">swifttcg.com</a>
                </p>
                <p style="margin:0;color:#666666;font-size:13px;line-height:1.55;">
                  Authentic Japanese TCG imports — factory sealed, shipped from California.
                </p>
              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>
  </body>
</html>
