# Shopify Storefront API
# Copy to .env.local and fill in real values.
# Domain only (no https://), e.g. your-store.myshopify.com
#
# Prefer the Headless channel private access token (starts with shpat_).
# The client sends it as Shopify-Storefront-Private-Token server-side.
# Public tokens (unprefixed) still work via X-Shopify-Storefront-Access-Token.
#
# Required Storefront permissions (Headless → storefront → Edit permissions):
#   - unauthenticated_read_product_listings
#   - unauthenticated_write_checkouts  (cart create / lines / checkout)
#   - unauthenticated_read_product_inventory  (quantityAvailable for bag qty caps)
#   - unauthenticated_read_content  (Online Store pages + shop policies)
#   - unauthenticated_read_metaobjects  (Storefront Hero / Visual CMS — see docs/STOREFRONT_CMS.md)
#
# Also expose shop metafields under namespace `swift` to the Storefront API
# (Settings → Custom data → Shop → metafield definitions → Storefront access):
#   business_email, response_time, instagram_url, x_url, discord_url, youtube_url
#
# Metaobject definitions (storefront_hero, storefront_visual) are created by
# `npm run setup:cms` with Storefronts PUBLIC_READ access enabled.
# See docs/STOREFRONT_CMS.md.
# After changing Headless permissions, re-test quantityAvailable. If still
# ACCESS_DENIED, generate a new private token and update SHOPIFY_STOREFRONT_TOKEN.


SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2025-10

# ---------------------------------------------------------------------------
# Shopify New Customer Accounts (Customer Account API) — headless OAuth
# ---------------------------------------------------------------------------
# Prerequisites (Admin):
#   Settings → Customer accounts → Accounts in online store and checkout
#   → Customer accounts (NOT legacy). Verified via shop.customerAccountsV2.
#
# Credentials (Admin → Sales channels → Headless → your storefront
# → Customer Account API):
#   - Copy Client ID
#   - Client type: Public (PKCE) for this Next.js storefront, or Confidential
#     if you also set SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET
#   - Callback URL(s): https://<your-domain>/account/authorize
#     (HTTPS required; use an ngrok/tunnel URL for local testing — localhost
#     callbacks are rejected by Shopify)
#   - Logout URL: https://<your-domain>/
#   - Permissions: customer read/write as needed for orders, profile, addresses
#
# Shop id is the numeric id from discovery
# (https://{shop}/.well-known/customer-account-api → shopify.com/{shopId}/...).
# For Swift TCG development store this is 78387708009.

SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# Optional — only for confidential Customer Account API clients
# SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
SHOPIFY_SHOP_ID=
# Public HTTPS origin of this storefront (no trailing slash)
SHOPIFY_APP_URL=
# Optional override for sealing session cookies (defaults to SHOPIFY_CLIENT_SECRET)
# SHOPIFY_CUSTOMER_ACCOUNT_SESSION_SECRET=
# Optional path overrides (defaults shown)
# SHOPIFY_CUSTOMER_ACCOUNT_CALLBACK_PATH=/account/authorize
# SHOPIFY_CUSTOMER_ACCOUNT_LOGOUT_PATH=/

# Verify config: npx tsx scripts/verify-customer-accounts.ts

# Shopify Admin API (importer / product sync + collection assignment)
# Dev Dashboard app client credentials (client credentials grant).
# Used by lib/shopify/admin.ts — required for `npm run import:sora` Shopify sync.
# The client requests a short-lived Admin access token automatically (no static shpat_).
# Recommended Admin scopes (Dev Dashboard app config, then reinstall/update on store):
#   read_products, write_products, read_publications, write_publications
#   read_content, write_content          (Online Store pages)
#   read_legal_policies, write_legal_policies  (Shipping / Refund / Privacy / Terms)
#   write_metaobject_definitions, write_metaobjects  (Storefront CMS — `npm run setup:cms`)
#   read_metaobject_definitions, read_metaobjects     (CMS reads / idempotent verify)
#   write_files, read_files              (upload hero / visual images to Files)
#   write_products                       (also required by setup:cms for custom.release_date)
# Without read_products / write_products, product sync will fail with Access denied.
# Without write_content / write_legal_policies, `npm run shopify:seed-content` cannot
# create informational pages or policies.
# Without metaobject / files / write_products scopes, `npm run setup:cms` cannot create
# CMS definitions or the Product Release Date metafield.

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional: preview Shopify create/update/skip without mutations.
# Also supported: `npm run import:sora -- --dry-run` or DRY_RUN=1
# SHOPIFY_DRY_RUN=1

# Newsletter ESP (optional — leave unset until a provider is wired)
# Until NEWSLETTER_PROVIDER is implemented, /api/newsletter returns
# status: provider_not_configured (no fake success).
# Planned values once integrated: klaviyo | shopify
# NEWSLETTER_PROVIDER=
# KLAVIYO_API_KEY=
# KLAVIYO_LIST_ID=
# (Shopify Email / customer marketing would reuse Admin credentials above)
