# Shopify Storefront API
# Copy to .env.local and fill in real values.
# Domain only (no https://), e.g. your-store.myshopify.com
#
# Prefer the Headless channel private access token (starts with shpat_).
# The client sends it as Shopify-Storefront-Private-Token server-side.
# Public tokens (unprefixed) still work via X-Shopify-Storefront-Access-Token.
#
# Required Storefront permissions (Headless → storefront → Edit permissions):
#   - unauthenticated_read_product_listings
#   - unauthenticated_write_checkouts  (cart create / lines / checkout)
#   - unauthenticated_read_product_inventory  (quantityAvailable for bag qty caps)
#   - unauthenticated_read_content  (Online Store pages + shop policies)
#   - unauthenticated_read_metaobjects  (Storefront Hero / Visual CMS — see docs/STOREFRONT_CMS.md)
#
# Also expose shop metafields under namespace `swift` to the Storefront API
# (Settings → Custom data → Shop → metafield definitions → Storefront access):
#   business_email, response_time, instagram_url, x_url, discord_url, youtube_url
#
# Metaobject definitions (storefront_hero, storefront_visual) are created by
# `npm run setup:cms` with Storefronts PUBLIC_READ access enabled.
# See docs/STOREFRONT_CMS.md.
# After changing Headless permissions, re-test quantityAvailable. If still
# ACCESS_DENIED, generate a new private token and update SHOPIFY_STOREFRONT_TOKEN.

# ---------------------------------------------------------------------------
# Shop Pay (accelerated checkout)
# ---------------------------------------------------------------------------
# No extra env vars. The storefront reads SHOPIFY_STORE_DOMAIN for the official
# <shop-pay-button store-url> attribute (Checkout Links).
#
# Admin (required for the button to render):
#   Settings → Payments → Shopify Payments must be active
#   Shop Pay must be enabled (Shopify Payments → Shop Pay)
#   Eligible store / region (Shop Pay availability)
#
# Headless notes:
#   - Add to Cart / Checkout is unchanged (Shopify cart → checkoutUrl)
#   - Shop Pay on PDP + cart uses Shopify's Buy with Shop Pay web component
#   - Hosted checkout already offers Shop Pay as a wallet when the above is on
#   - If Shop Pay is off, Shopify removes the official button from the DOM
# Docs: https://shopify.dev/docs/storefronts/headless/additional-sdks/web-components
# Branding: https://help.shopify.com/en/manual/payments/shop-pay/assets


SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2025-10

# ---------------------------------------------------------------------------
# Shopify New Customer Accounts (Customer Account API) — headless OAuth
# ---------------------------------------------------------------------------
# Prerequisites (Admin):
#   Settings → Customer accounts → Accounts in online store and checkout
#   → Customer accounts (NOT legacy). Verified via shop.customerAccountsV2.
#
# Credentials (Admin → Sales channels → Headless → your storefront
# → Customer Account API):
#   - Copy Client ID
#   - Client type: Public (PKCE) for this Next.js storefront, or Confidential
#     if you also set SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET
#   - Callback URL(s): https://<your-domain>/account/authorize
#     (HTTPS required; use an ngrok/tunnel URL for local testing — localhost
#     callbacks are rejected by Shopify)
#   - Logout URL: https://<your-domain>/
#   - Permissions: customer read/write as needed for orders, profile, addresses
#   - Wishlist: run `npm run setup:wishlist`, then Admin → Custom data →
#     Customers → Wishlist → Customer account access = Read and write
#   - Back in Stock: run `npm run setup:back-in-stock`, then Admin → Custom data →
#     Customers → Back in Stock → Customer account access = Read and write
#   - Reviews: run `npm run setup:reviews` (metaobject + product aggregates).
#     See docs/PRODUCT_REVIEWS.md. Purchases are verified via Admin read_orders.
#
# Shop id is the numeric id from discovery
# (https://{shop}/.well-known/customer-account-api → shopify.com/{shopId}/...).
# For Swift TCG development store this is 78387708009.

SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
# Optional — only for confidential Customer Account API clients
# SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
SHOPIFY_SHOP_ID=
# Public HTTPS origin of this storefront (no trailing slash).
# Canonical production origin is https://www.swifttcg.com — set this to www,
# not apex. Apex should only 308-redirect to www; OAuth redirect_uri must match
# the browsable www host exactly.
# Register the same origin in Headless → Customer Account API:
#   Callback: {SHOPIFY_APP_URL}/account/authorize
#   Logout:   {SHOPIFY_APP_URL}/
SHOPIFY_APP_URL=https://www.swifttcg.com
# Optional override for sealing session cookies (defaults to SHOPIFY_CLIENT_SECRET)
# SHOPIFY_CUSTOMER_ACCOUNT_SESSION_SECRET=
# Optional path overrides (defaults shown)
# SHOPIFY_CUSTOMER_ACCOUNT_CALLBACK_PATH=/account/authorize
# SHOPIFY_CUSTOMER_ACCOUNT_LOGOUT_PATH=/

# Verify config: npx tsx scripts/verify-customer-accounts.ts

# Shopify Admin API (importer / product sync + collection assignment)
# Dev Dashboard app client credentials (client credentials grant).
# Used by lib/shopify/admin.ts — required for `npm run import:sora` Shopify sync.
# The client requests a short-lived Admin access token automatically (no static shpat_).
# Recommended Admin scopes (Dev Dashboard app config, then reinstall/update on store):
#   read_products, write_products, read_publications, write_publications
#   read_content, write_content          (Online Store pages)
#   read_legal_policies, write_legal_policies  (Shipping / Refund / Privacy / Terms)
#   write_metaobject_definitions, write_metaobjects  (Storefront CMS — `npm run setup:cms`)
#   read_metaobject_definitions, read_metaobjects     (CMS reads / idempotent verify)
#   write_files, read_files              (upload hero / visual images to Files)
#   write_products                       (also required by setup:cms for custom.release_date)
#   read_customers, write_customers      (wishlist + back-in-stock metafields / setup scripts)
#   read_orders                          (product reviews — purchase verification)
#   (+ same metaobject/files scopes for `npm run setup:reviews`)
# Without read_products / write_products, product sync will fail with Access denied.
# Without write_content / write_legal_policies, `npm run shopify:seed-content` cannot
# create informational pages or policies.
# Without metaobject / files / write_products scopes, `npm run setup:cms` cannot create
# CMS definitions or the Product Release Date metafield.

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional: preview Shopify create/update/skip without mutations.
# Also supported: `npm run import:sora -- --dry-run` or DRY_RUN=1
# SHOPIFY_DRY_RUN=1

# Newsletter ESP (optional — leave unset until a provider is wired)
# Until NEWSLETTER_PROVIDER is implemented, /api/newsletter returns
# status: provider_not_configured (no fake success).
# Planned values once integrated: klaviyo | shopify
# NEWSLETTER_PROVIDER=
# KLAVIYO_API_KEY=
# KLAVIYO_LIST_ID=
# (Shopify Email / customer marketing would reuse Admin credentials above)

# ---------------------------------------------------------------------------
# Back in Stock alerts (transactional email + Vercel Cron)
# ---------------------------------------------------------------------------
# Metafields: npm run setup:back-in-stock
# Cron hits GET /api/cron/back-in-stock every 15m (see vercel.json).
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> automatically when
# CRON_SECRET is set in the project env.
# RESEND_API_KEY=
# BACK_IN_STOCK_FROM_EMAIL=Swift TCG <noreply@swifttcg.com>
# CRON_SECRET=

# ---------------------------------------------------------------------------
# Product Reviews (Shopify metaobjects)
# ---------------------------------------------------------------------------
# Schema: npm run setup:reviews
# Docs: docs/PRODUCT_REVIEWS.md
# setup:reviews also registers metaobject webhooks → /api/webhooks/reviews
# Webhook HMAC (optional override; defaults to SHOPIFY_CLIENT_SECRET):
# SHOPIFY_WEBHOOK_SECRET=
# Hourly cron: GET /api/cron/reviews (Bearer CRON_SECRET)
#
# Cache invalidation webhooks (catalog + CMS):
#   npm run setup:cache-webhooks
# Callback: {SHOPIFY_APP_URL}/api/webhooks/cache
# Topics: products, collections, inventory_levels, metaobjects, shop/update
# METAOBJECTS_* require a Shopify delivery filter:
#   type:storefront_hero OR type:storefront_visual OR type:homepage OR …
# (Omitting the filter is rejected by Shopify — wildcards like type:* are
# not supported.) Runtime also guards by type in /api/webhooks/cache.
# Invalidates tags: shopify-catalog, storefront-cms, shopify-chrome, shopify-policies
# TTLs in lib/shopify/cache.ts are fallbacks only.

# ---------------------------------------------------------------------------
# Maintenance / Coming Soon (pre-launch)
# ---------------------------------------------------------------------------
# When true, the storefront redirects to /maintenance (HTTP 503 + Retry-After).
# API routes, /account/*, robots.txt, sitemap.xml, and static assets stay open.
# Set to false (or unset) to restore the live storefront — no code changes.
# MAINTENANCE_MODE=true
#
# Optional human-readable ETA shown on /maintenance
# MAINTENANCE_ETA=We're polishing the last few sets — back within a few days.
#
# Social CTAs on the maintenance page (Instagram is the primary button when set).
# INSTAGRAM_URL=https://www.instagram.com/your-handle/
# TWITTER_URL=https://x.com/your-handle
# DISCORD_URL=https://discord.gg/your-invite
# FACEBOOK_URL=https://www.facebook.com/your-page/

# ---------------------------------------------------------------------------
# SEO / Search Console
# ---------------------------------------------------------------------------
# Canonical origin is always https://www.swifttcg.com (see lib/seo/config.ts).
# SHOPIFY_APP_URL and NEXT_PUBLIC_SITE_URL must resolve to that same www host
# in production. Apex values are normalized to www for canonicals, OG, JSON-LD,
# sitemap.xml, and robots.txt — never emit the apex host in SEO output.
# NEXT_PUBLIC_SITE_URL=https://www.swifttcg.com
#
# Google Search Console HTML tag verification (content value only).
# When set, the storefront emits <meta name="google-site-verification" ...>.
# GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Google Analytics 4 (production only)
# ---------------------------------------------------------------------------
# Measurement ID from GA4 Admin → Data streams → Web (format: G-XXXXXXXXXX).
# Loaded only when NODE_ENV=production and this value is set. Leave unset
# locally — the storefront will not load gtag.js in development.
# On SPA navigations the app sends page_view via the App Router; in GA4
# Admin → Data stream → Enhanced measurement, disable “Page changes based
# on browser history events” so history listeners do not double-count.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ---------------------------------------------------------------------------
# Microsoft Clarity (production only)
# ---------------------------------------------------------------------------
# Project ID from clarity.microsoft.com → Settings → Setup.
# Loaded only when NODE_ENV=production and this value is set. Leave unset
# locally (or remove in production) to disable Clarity entirely.
# NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ---------------------------------------------------------------------------
# Sentry (error monitoring — production-grade observability)
# ---------------------------------------------------------------------------
# Docs: docs/SENTRY.md
# Initializes only when a DSN is set. Leave all of these unset locally to
# disable Sentry entirely (dev/build still work).
#
# DSN (same value for both). Public DSN is required for browser events.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
#
# Source map upload during `next build` (Vercel Build env — never NEXT_PUBLIC):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
#
# Optional overrides (defaults: Vercel env + git SHA, 10% prod traces,
# 5% session replay / 100% error replay):
# SENTRY_ENVIRONMENT=production
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=
# NEXT_PUBLIC_SENTRY_RELEASE=
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_TRACES_SAMPLE_RATE=0.1
# NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0.05
# NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=1

